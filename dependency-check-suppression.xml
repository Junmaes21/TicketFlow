<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
   <suppress>
      <notes><![CDATA[PyJWT coincide por error con el CPE generico "jwt", generando falsos positivos.]]></notes>
      <packageUrl regex="true">^pkg:pypi/pyjwt@.*$</packageUrl>
      <cpe>cpe:2.3:a:jwt_project:jwt</cpe>
   </suppress>
   <suppress>
      <notes><![CDATA[Mismo caso con el CPE alterno.]]></notes>
      <packageUrl regex="true">^pkg:pypi/pyjwt@.*$</packageUrl>
      <cpe>cpe:2.3:a:pyjwt_project:pyjwt</cpe>
   </suppress>
</suppressions>